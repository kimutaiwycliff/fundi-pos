# Dev-only defaults. Copy to .env and adjust; never commit the real .env.
POSTGRES_DB=pos_saas
POSTGRES_USER=pos_admin
POSTGRES_PASSWORD=dev_only_change_me
PAYLOAD_SECRET=dev_only_change_me_to_a_long_random_string

# PowerSync (self-hosted Open Edition). Only env vars prefixed PS_ can be
# substituted into powersync/*.yaml — this is enforced by the service itself.
PS_PORT=8080
# Source DB PowerSync replicates FROM (our app's Postgres, above).
PS_DATA_SOURCE_URI=postgres://pos_admin:dev_only_change_me@postgres:5432/pos_saas
# Separate Postgres PowerSync uses for its OWN internal bucket storage —
# intentionally distinct from the app DB, per PowerSync's own self-hosting
# reference (github.com/powersync-ja/self-host-demo, postgres-bucket-storage demo).
POSTGRES_STORAGE_PASSWORD=dev_only_change_me_2
PS_STORAGE_SOURCE_URI=postgres://powersync_storage:dev_only_change_me_2@postgres-storage:5432/powersync_storage
# JWKS endpoint Payload will expose once the auth handshake is wired in Phase 2.
# Left pointing at a not-yet-real endpoint for the Phase 0 spike; PowerSync
# only fetches this lazily on client auth, not at boot.
PS_JWKS_URL=http://host.docker.internal:3011/api/powersync/jwks
# PowerSync's own admin API token (powersync/powersync.yaml's api.tokens) -
# must be PS_-prefixed like everything else substituted into that file.
PS_ADMIN_TOKEN=dev_only_change_me_admin_token

# Required by apps/api/src/lib/powersyncAuth.ts (client-auth JWT signing) -
# no dev default on purpose, generate a real RSA keypair even for local use.
POWERSYNC_JWT_PRIVATE_KEY=
POWERSYNC_JWT_PUBLIC_KEY=
POWERSYNC_JWT_KID=

# Cloudflare R2 (S3-compatible) - product/variant image storage. Leave blank
# to disable (Payload falls back to local-disk uploads, fine for local dev
# only - a production box's uploads must go to real object storage, since
# local-disk writes don't survive this container being recreated on deploy).
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=
