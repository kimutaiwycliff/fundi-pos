# Local deploy settings for the Makefile's VPS targets. Copy to .env.deploy
# (gitignored) and fill in - these identify the production box and the
# co-located app's infrastructure, so they never go in git.
DEPLOY_HOST=
# Co-located Caddy (see `make vps-caddy-sites`): host paths are relative to
# DEPLOY_USER's home directory.
CADDY_SITES_DIR=
CADDY_MAIN_FILE=
CADDY_CONTAINER=
