{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    /* Nx's inferred typecheck target runs `tsc --build --emitDeclarationOnly`,
       which requires every project in the reference graph (this one included,
       since it has its own `include` alongside `references`) to be a valid
       composite project - `noEmit` conflicts with that, so declaration-only
       emission is used instead (vite/esbuild does the real transpilation;
       these .d.ts files land in the same gitignored dist/ vite build clears). */
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "jsx": "react-jsx",

    /* Mirrors vite.config.ts's resolve.alias workaround for an npm hoisting
       quirk that leaves @powersync/common reachable only from here, not from
       the workspace root where @powersync/shared-internals/tauri-plugin are
       hoisted to and import it from. Paths resolve relative to this file
       without needing baseUrl (TS 4.1+). */
    "paths": {
      "@powersync/common": ["./node_modules/@powersync/common"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../packages/shared-types"
    },
    {
      "path": "../../packages/business-logic"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
