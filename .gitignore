# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# secrets
*.pem
*.key

# TypeScript incremental build cache
*.tsbuildinfo

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

vite.config.*.timestamp*
vitest.config.*.timestamp*
.claude/worktrees
.claude/settings.local.json
.nx/polygraph
.nx/self-healing
.nx/migrate-runs
# Next.js build output
.next/
apps/*/.next/

# Tauri / Rust build artifacts
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# Secrets — never commit real env files, only .env.example
.env
.env.*
!.env.example
!docker/.env.example
# Not a secret: real public production URLs baked into every distributed
# desktop build (same class as apps/web's own NEXT_PUBLIC_API_URL) - must
# actually be committed, or CI never sees it and every release silently
# reverts to the localhost dev default.
!apps/desktop/.env.production

# Postgres data volume (bind-mounted locally, if ever used instead of a named volume)
docker/pgdata/

# Expo
node_modules/
.expo/
.yarn/
dist/
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
cache/

